{
  "name": "n8n-nodes-zena",
  "version": "0.8.6",
  "description": "Zena AI - Automate WhatsApp. Official n8n nodes for Zena WhatsApp AI CRM.",
  "keywords": [
    "n8n-community-node-package",
    "zena",
    "whatsapp",
    "crm",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://zena.fictoralabs.ae",
  "author": {
    "name": "Fictoralabs",
    "email": "admin@fictoralabs.ae"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fictoralabs/n8n-nodes-zena.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-icons",
    "copy-icons": "for f in nodes/*/*.svg; do d=\"dist/$f\"; mkdir -p \"$(dirname \"$d\")\" && cp \"$f\" \"$d\"; done",
    "dev": "tsc --watch",
    "format": "prettier index.ts credentials nodes shared --write",
    "lint": "eslint index.ts credentials nodes shared --ext .ts",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "credentials",
    "nodes",
    "shared",
    "index.ts"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZenaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Zena/Zena.node.js",
      "dist/nodes/ZenaTrigger/ZenaTrigger.node.js",
      "dist/nodes/ZenaWebhookTrigger/ZenaWebhookTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "n8n-workflow": "^2.13.1",
    "prettier": "^3.6.2",
    "typescript": "^5.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
